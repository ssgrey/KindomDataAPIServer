<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 程序界面显示的版本号 -->
    <add key="Version" value="1.0.14" />
    <!-- 井头数据同步到 Web 时，每批上传的井数 -->
    <add key="OnceSyncWellCount_WellHeader" value="5000" />

    <!-- 从 Kingdom 读取分层数据时，每批查询的 UWI 数量 -->
    <add key="well_formation_readUwiBatchSize" value="20" />
    <!-- 分层数据同步到 Web 时，每批上传的层位记录数 -->
    <add key="OnceSyncWellCount_WellFormation" value="200" />
    <!-- 分层数据上传到 Web 时的并发任务数 -->
    <add key="well_formation_uploadConcurrency" value="2" />


    <!-- 井斜数据同步到 Web 时，每批上传的井数 -->
    <add key="OnceSyncWellCount_WellTrajectory" value="3" />
    <!-- 井斜数据上传到 Web 时的并发任务数 -->
    <add key="well_trajectory_uploadConcurrency" value="3" />


    <!-- 测井曲线上传到 Web 时的并发任务数 -->
    <add key="well_log_uploadConcurrency" value="5" />
    <!-- 测井曲线同步到 Web 时，每批上传的曲线数 -->
    <add key="well_log_batchCurveCount" value="3" />

    <!-- 生产数据上传到 Web 时的并发任务数 -->
    <add key="well_production_uploadConcurrency" value="3" />
    <!-- 生产数据同步到 Web 时，每批上传的日数据条数 -->
    <add key="well_production_batchDailyDataCount" value="300" />


    <!-- 从 Web 导入测井曲线到 Kingdom 时，每批处理的井数 -->
    <add key="OnceSyncWellCount_Logs" value="5" />
    <!-- 从 Web 导入解释层段到 Kingdom 时，每批查询的井数 -->
    <add key="OnceSyncWellCount_Intervals" value="50" />


    <!-- 是否使用临时文件导入分层数据；false 使用 Protobuf 接口 -->
    <add key="well_formation_useFileImport" value="false" />
    <!-- 是否要求同步分层或测井数据时必须选择具体层位或曲线 -->
    <add key="RequireFormationAndLogSelection" value="false" />
    <!-- 是否在界面菜单中显示高级设置入口 -->
    <add key="ShowAdvancedSettingsMenu" value="false" />

    <!-- 获取用户凭据接口所使用的 API Token -->
    <add key="api-token" value="b2b37b07ef5511ef93561091d1af829b" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Cors" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
